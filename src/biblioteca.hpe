DIR

@ Publico

  zcalc
    ´
    CLEAR
    @Configura en modo grados
    DEG

    "longitud_accion" {"r_p" "r_g" "a" "ang_p" "ex_0 in_1"} {2. 4.}
    {} {}
    INFORM

    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET

    'EXIN' STO
    'ANGP' STO
    'A' STO
    'RG' STO
    'RP' STO

    IF
    'EXIN==0'
    THEN
        RP A + 2^
        RP ANGP COS * 2^
        -
        É

        RG A + 2 ^
        RG ANGP COS * 2^
        -
        É

        +
        RP RG + ANGP SIN *
        - "Z" çTAG
    ELSE
        RP A + 2^
        RP ANGP COS * 2^
        -
        É

        RG A - 2 ^
        RG ANGP COS * 2^
        -
        É

        -
        RG RP - ANGP SIN *
        + "Z" çTAG
    END


    {EXIN ANGP A RG RP lista} PURGE
    ª

  balan
    ´
    CLEAR    
    @Configura en modo grados
    DEG

    "balanceo" {"F_0" "o_0" "F_B" "o_B" "R_1" "R_2" "l_1" "l_2" "l_B" "w" } { 3 0 }
    { } { }
    INFORM

    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET
    lista 6 GET
    lista 7 GET
    lista 8 GET
    lista 9 GET
    lista 10 GET

    'W' STO
    'lB' STO
    'l2' STO
    'l1' STO
    'R2' STO
    'R1' STO
    'oB' STO
    'FB' STO
    'o0' STO
    'F0' STO

    @Dividir fuerza en ejes
    F0 o0 COS *
    'F0x' STO
    F0 o0 SIN *
    'F0y' STO
    FB oB COS *
    'FBx' STO
    FB oB SIN *
    'FBy' STO

    @Calcular productos de masa radio el plano 1
    @para x
    F0x NEG l1 NEG *
    lB l1 -
    FBx NEG
    *
    +

    l2 l1 -
    W 2^
    *

    /
    'M2R2x' STO

    @para y
    F0y NEG l1 NEG *
    lB l1 -
    FBy NEG
    *
    +

    l2 l1 -
    W 2^
     *

     /
     'M2R2y' STO

    @Calcular productos de masa radio el plano 2
    @para x
    F0x NEG l2 NEG *
    lB l2 -
    FBx NEG
    *
    +

    l1 l2 -
    W 2^
    *

    /
    'M1R1x' STO

    @para y
    F0y NEG l2 NEG *
    lB l2 -
    FBy NEG
    *
    +

    l1 l2 -
    W 2^
    *

    /
    'M1R1y' STO

    @Calcular angulo plano 2
    @primer cuadrante
    IF 'M2R2x>0' 'M2R2y>0' AND
    THEN
        M2R2y M2R2x / ATAN
    END
    @segundo cuadrante
    IF 'M2R2x<0' 'M2R2y>0' AND
    THEN
        M2R2y M2R2x / ATAN 180 +
    END
    @tercer cudrante
    IF 'M2R2x<0' 'M2R2y<0' AND
    THEN
        M2R2y M2R2x / ATAN 180 -
    END
    @cuarto cudrante
    IF 'M2R2x>0' 'M2R2y<0' AND
    THEN
        M2R2y M2R2x / ATAN
    END
    'o2' STO

    @Calcular angulo plano 3
    @primer cuadrante
    IF 'M1R1x>0' 'M1R1y>0' AND
    THEN
        M1R1y M1R1x / ATAN
    END
    @segundo cuadrante
    IF 'M1R1x<0' 'M1R1y>0' AND
    THEN
        M1R1y M1R1x / ATAN 180 +
    END
    @tercer cudrante
    IF 'M1R1x<0' 'M1R1y<0' AND
    THEN
        M1R1y M1R1x / ATAN 180 -
    END
    @cuarto cudrante
    IF 'M1R1x>0' 'M1R1y<0' AND
    THEN
        M1R1y M1R1x / ATAN
    END
    'o1' STO


    @Calcular masa 2
    1 R2 /
    M2R2x 2^ M2R2y 2^ + É
    *
    'M2' STO
    @Calcular masa 1
    1 R1 /
    M1R1x 2^ M1R1y 2^ + É
    *
    'M1' STO

    @Calcular fuerza 2
    W 2^ M2 * R2 *
    'F2' STO

    F2 o2 COS *
    'F2x' STO
    F2 o2 SIN *
    'F2y' STO

    @Calcular fuerza 1
    W 2^ M1 * R1 *
    'F1' STO

    F1 o1 COS *
    'F1x' STO
    F1 o1 SIN *
    'F1y' STO

    @Calcular inercia 2
    R2 2^ M2 *
    'I2' STO
    @Calcular inercia 1
    R1 2^ M1 *
    'I1' STO

    @Resultados
    F0x "F0_x" çTAG
    F0y "F0_y" çTAG
    F1x "F1_x" çTAG
    F1y "F1_y" çTAG
    F2x "F2_x" çTAG
    F2y "F2_y" çTAG
    FBx "FB_x" çTAG
    FBy "FB_y" çTAG
    M2R2x "M2R2_x" çTAG
    M2R2y "M2R2_y" çTAG
    M1R1x "M1R1_x" çTAG
    M1R1y "M1R1_y" çTAG
    o2 "o_2" çTAG
    o1 "o_1" çTAG
    M2 "M2" çTAG
    M1 "M1" çTAG
    F2 "F2" çTAG
    F1 "F1" çTAG
    I2 "I2" çTAG
    I1 "I1" çTAG


    {I1 I2 F1x F1y F1 F2y F2x F2 M1 M2 o1 o2 M1R1y M1R1x M2R2y M2R2x FBy FBx F0y F0x lista
    W lB l2 l1 R2 R1 oB FB o0 F0} PURGE    
    ª    
    
  volan
    ´
    CLEAR
    @Configura en modo radianes
    RAD

    @Recojer los datos
    "volante" {"A" "w_2" "k"} { 1 0 }
    { } { }
    INFORM
    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET

    'k' STO
    'w2' STO
    'A' STO

    @Primer termino
    "T_1" {"K_1" "B_1" "C_1" "min" "max"} { 3 0 }
    { } { }
    INFORM
    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET

    'limmax1' STO
    'limmin1' STO
    'C1' STO
    'B1' STO
    'K1' STO

    @Formar la expresion (fun = K + A*B_x * sen(C_x*o2))
    B1 A *
    C1 o2 * SIN
    *
    K1 +
    'fun1' STO

    @Segundo termino
    "T_2" {"K_2" "B_2" "C_2" "min" "max"} { 3 0 }
    { } { }
    INFORM
    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET

    'limmax2' STO
    'limmin2' STO
    'C2' STO
    'B2' STO
    'K2' STO

    @Formar la expresion (fun = K + A*B_x * sen(C_x*o2))
    B2 A *
    C2 o2 * SIN
    *
    K2 +
    'fun2' STO

    @Tercer termino
    "T_3" {"K_3" "B_3" "C_3" "min" "max"} { 3 0 }
    { } { }
    INFORM
    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET

    'limmax3' STO
    'limmin3' STO
    'C3' STO
    'B3' STO
    'K3' STO

    @Formar la expresion (fun = K + A*B_x * sen(C_x*o2))
    B3 A *
    C3 o2 * SIN
    *
    K3 +
    'fun3' STO

    @Cuarto termino
    "T_4" {"K_4" "B_4" "C_4" "min" "max" } { 3 0 }
    { } { }
    INFORM
    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET

    'limmax4' STO
    'limmin4' STO
    'C4' STO
    'B4' STO
    'K4' STO

    @Formar la expresion (fun = K + A*B_x * sen(C_x*o2))
    B4 A *
    C4 o2 * SIN
    *
    K4 +
    'fun4' STO

    @Calcular el par de torsion promedio
    limmin1 limmax1 fun1 o2 Ñ
    'E1' STO
    limmin2 limmax2 fun2 o2 Ñ
    'E2' STO
    limmin3 limmax3 fun3 o2 Ñ
    'E3' STO
    limmin4 limmax4 fun4 o2 Ñ
    'E4' STO
    E1 E2 E3 E4 + + +
    limmax4 /
    'Tprom' STO

    @Calcular la posicon maxima y minima de velociad de rotacion

    E1
    limmax1 limmin1 -
    Tprom *
    -
    'A1' STO

    E2
    limmax2 limmin2 -
    Tprom *
    -
    'A2' STO

    E3
    limmax3 limmin3 -
    Tprom *
    -
    'A3' STO

    E4
    limmax4 limmin4 -
    Tprom *
    -
    'A4' STO

    @Lista del acumulado de energia
    A1
    A1 A2 +
    A1 A2 A3 + +
    A1 A2 A3 A4 + + +
    4 çLIST
    'Elist' STO

    @Valor de energia del volante
    Elist SORT
    LISTç
    DROP
    'Emax' STO
    DROP
    DROP
    'Emin' STO
    Emax Emin - ABS
    'E' STO

    @Inercia del volante
    E
    k w2 w2 * *
    /
    'I' STO

    @Resultados
    E1 "E_1" çTAG
    E2 "E_2" çTAG
    E3 "E_3" çTAG
    E4 "E_4" çTAG
    Tprom "Tprom" çTAG
    A1 "A_1" çTAG
    A2 "A_2" çTAG
    A3 "A_3" çTAG
    A4 "A_4" çTAG
    Elist "E_list" çTAG
    I "I" çTAG

    @Eliminar todas la varibles
    {I Elist A4 A3 A2 A1 Tprom E4 E3 E2 E1 Emax Emin Elist fun4 fun3 fun2 fun1 B4 B3 B2 B1
    C4 C3 C2 C1 limmax4 limmax3 limmax2 limmax1 limmin4 limmin3 limmin2 limmin1 lista k w2 A K1 K2 K3 K4 E IERR} PURGE    
