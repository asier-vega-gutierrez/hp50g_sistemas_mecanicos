  x009
  ´ CLEAR CLLCD "M-C INVERTIDA ABIERTA" { { "Eslabon 1:" "Longitud de la
bancada" 0 } { "Eslabon 2:" "Longitud de entrada" 0 } { "Eslabon 4:" "Longitud
de la salida" 0 } { "Angulo ë:" "Angulo entre ï3 y ï4" 0 } { "Angulo ï2:"
"Angulo entre esl.1 y esl.2" 0 } } { 2 0 } { } { } INFORM DROP OBJç DROP 'ï2'
STO 'ë' STO 'c' STO 'a' STO 'd' STO 'a*SIN(ï2)*SIN(ë)+(a*COS(ï2)-d)*COS(ë)'
EVAL 'P' STO '-a*SIN(ï2)*COS(ë)+(a*COS(ï2)-d)*SIN(ë)' EVAL 'Q' STO '-c*SIN(ë)'
EVAL 'R' STO 'R-Q' EVAL 'S' STO '2*P' EVAL 'T' STO 'Q+R' EVAL 'U' STO
'ATAN((-T+É(T^2-4*S*U))/(2*S))*2' EVAL 'ï4' STO
    IF ï4 TYPE 1 ã
    THEN ï4 ë + 'ï3' STO '(a*SIN(ï2)-c*SIN(ï4))/SIN(ï3)' EVAL 'b' STO
