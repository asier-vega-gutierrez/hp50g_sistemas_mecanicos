  x006
  ´ CLEAR CLLCD "MANIVELA-CORREDERA ABIERTA" { { "Eslabon 2:" "Longitud de
entrada" 0 } { "Eslabon 3:" "Longitud del acoplador" 0 } { "Descentrado:"
"Dist. entre eje corredera y pivote maniv." 0 } { "Angulo ï2:" "Angulo entre
esl.1 y esl.2" 0 } } { 2 0 } { } { } INFORM DROP OBJç DROP 'ï2' STO 'c' STO 'b'
STO 'a' STO 'ASIN(-(a*SIN(ï2)-c)/b)+180' EVAL 'ï3' STO
    IF ï3 TYPE 1 ã
    THEN
      IF ï3 0 <
      THEN ï3 360 + 'ï3' STO
      END 'a*COS(ï2)-b*COS(ï3)' EVAL 'd' STO 'a*COS(ï2)+a*SIN(ï2)*i' EVAL 'R2'
STO 'b*COS(ï3)+b*SIN(ï3)*i' EVAL 'R3' STO
      IF c 0 >
      THEN 'c*COS(90)+c*SIN(90)*i' EVAL 'R4' STO
      ELSE 'c*COS(270)+c*SIN(270)*i' EVAL 'R4' STO
      END 'd*COS(0)+d*SIN(0)*i' EVAL 'R1' STO x008 { { "VELO" x014 } { "GRAF"
x00E } { "D.PO" x008 } { } { "APOS" x006 } { "INIC" x002 } } TMENU
    ELSE CLLCD "Con estas dimensiones el mecanismo no es posible" MSGBOX CLEAR
    END
