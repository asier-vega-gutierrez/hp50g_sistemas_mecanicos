  x003
    ´ CLEAR CLLCD "JUNTA PASADOR ABIERTO" { { "Eslabon 1:" "Longitud de la
    bancada" 0 } { "Eslabon 2:" "Longitud de entrada" 0 } { "Eslabon 3:" "Longitud
    del acoplador" 0 } { "Eslabon 4:" "Longitud de la salida" 0 } { "Angulo ï2:"
    "Angulo entre esl.1 y esl.2" 0 } } { 2 0 } { } { } INFORM DROP OBJç DROP 'ï2'
    STO 'c' STO 'b' STO 'a' STO 'd' STO CLEAR d a b c 4 çLIST SORT HEAD d a b c 4
    çLIST SORT REVLIST HEAD ç S L
      ´ S L + 'N' STO
      IF N DUP d a + b c + + - ABS â
      THEN
        IF N DUP d a + b c + + - ABS <
        THEN 1 'G' STO 'N' PURGE CLLCD "El mecanismo es de Grashof. Clase I"
        MSGBOX 'N' PURGE
        ELSE 3 'G' STO 'N' PURGE CLLCD "El mecanismo es de Grashof. Clase III"
        MSGBOX
        END
      ELSE 2 'G' STO 'N' PURGE CLLCD "El mecanismo no es de Grashof. Clase II"
      MSGBOX
      END CLLCD d a / 'K1' STO d c / 'K2' STO
      '(a^2-b^2+c^2+d^2)/(2*a*c)' EVAL 'K3' STO ï2 COS K1 - K2 ï2 COS * - K3 + 'A'
      STO 0 2 - ï2 SIN * 'B' STO K1 K2 1 + ï2 COS * - K3 + 'C' STO
      'ATAN((-B-É(B^2-4*A*C))/(2*A))*2' EVAL 'ï4' STO
      IF ï4 TYPE 1 ã
      THEN
        IF ï4 0 <
        THEN ï4 360 + 'ï4' STO
        END d b / 'K4' STO '(c^2-d^2-a^2-b^2)/(2*a*b)' EVAL 'K5' STO ï2 COS K1
        - K4 ï2 COS * + K5 + 'D' STO 0 2 - ï2 SIN * 'E' STO K1 K4 1 - ï2 COS * + K5 +
        'F' STO 'ATAN((-E-É(E^2-4*D*F))/(2*D))*2' EVAL 'ï3' STO
        IF ï3 0 <
        THEN ï3 360 + 'ï3' STO
        END 'a*COS(ï2)+a*SIN(ï2)*i' EVAL 'R2' STO 'b*COS(ï3)+b*SIN(ï3)*i' EVAL
        'R3' STO 'c*COS(ï4)+c*SIN(ï4)*i' EVAL 'R4' STO 'd*COS(0)+d*SIN(0)*i' EVAL 'R1'
        STO x005 { { "VELO" x012 } { "GRAF" x00C } { "D.PO" x005 } { } { "APOS" x003 }
        { "INIC" x002 } } TMENU
      ELSE CLLCD "Con estas dimensiones el mecanismo no es posible" MSGBOX
      CLEAR
      END
      ª
