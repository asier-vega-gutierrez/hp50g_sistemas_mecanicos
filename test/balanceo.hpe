%%HP: T(0)A(D)F(.);
@ Autor: Asier
@ Versión: 0.1

CLEAR

    @Configura en modo grados
    DEG

    "balanceo" {"F_0" "o_0" "F_B" "o_B" "R_1" "R_2" "l_1" "l_2" "l_B" "w" } { 3 0 }
    { } { }
    INFORM

    DROP

    'lista' STO
    lista 1 GET
    lista 2 GET
    lista 3 GET
    lista 4 GET
    lista 5 GET
    lista 6 GET
    lista 7 GET
    lista 8 GET
    lista 9 GET
    lista 10 GET

    'W' STO
    'lB' STO
    'l2' STO
    'l1' STO
    'R2' STO
    'R1' STO
    'oB' STO
    'FB' STO
    'o0' STO
    'F0' STO

    @Dividir fuerza en ejes
    F0 o0 COS *
    'F0x' STO
    F0 o0 SIN *
    'F0y' STO
    FB oB COS *
    'FBx' STO
    FB oB SIN *
    'FBy' STO

    @Calcular productos de masa radio el plano 1
    @para x
    F0x NEG l1 NEG *
    lB l1 -
    FBx NEG
    *
    +

    l2 l1 -
    W 2^
    *

    /
    'M2R2x' STO

    @para y
    F0y NEG l1 NEG *
    lB l1 -
    FBy NEG
    *
    +

    l2 l1 -
    W 2^
     *

     /
     'M2R2y' STO

    @Calcular productos de masa radio el plano 2
    @para x
    F0x NEG l2 NEG *
    lB l2 -
    FBx NEG
    *
    +

    l1 l2 -
    W 2^
    *

    /
    'M1R1x' STO

    @para y
    F0y NEG l2 NEG *
    lB l2 -
    FBy NEG
    *
    +

    l1 l2 -
    W 2^
    *

    /
    'M1R1y' STO

    @Calcular angulo plano 2
    @primer cuadrante
    IF 'M2R2x>0' 'M2R2y>0' AND
    THEN
        M2R2y M2R2x / ATAN
    END
    @segundo cuadrante
    IF 'M2R2x<0' 'M2R2y>0' AND
    THEN
        M2R2y M2R2x / ATAN 180 +
    END
    @tercer cudrante
    IF 'M2R2x<0' 'M2R2y<0' AND
    THEN
        M2R2y M2R2x / ATAN 180 -
    END
    @cuarto cudrante
    IF 'M2R2x>0' 'M2R2y<0' AND
    THEN
        M2R2y M2R2x / ATAN
    END
    'o2' STO

    @Calcular angulo plano 3
    @primer cuadrante
    IF 'M1R1x>0' 'M1R1y>0' AND
    THEN
        M1R1y M1R1x / ATAN
    END
    @segundo cuadrante
    IF 'M1R1x<0' 'M1R1y>0' AND
    THEN
        M1R1y M1R1x / ATAN 180 +
    END
    @tercer cudrante
    IF 'M1R1x<0' 'M1R1y<0' AND
    THEN
        M1R1y M1R1x / ATAN 180 -
    END
    @cuarto cudrante
    IF 'M1R1x>0' 'M1R1y<0' AND
    THEN
        M1R1y M1R1x / ATAN
    END
    'o1' STO


    @Calcular masa 2
    1 R2 /
    M2R2x 2^ M2R2y 2^ + ƒ
    *
    'M2' STO
    @Calcular masa 1
    1 R1 /
    M1R1x 2^ M1R1y 2^ + ƒ
    *
    'M1' STO

    @Calcular fuerza 2
    W 2^ M2 * R2 *
    'F2' STO

    F2 o2 COS *
    'F2x' STO
    F2 o2 SIN *
    'F2y' STO

    @Calcular fuerza 1
    W 2^ M1 * R1 *
    'F1' STO

    F1 o1 COS *
    'F1x' STO
    F1 o1 SIN *
    'F1y' STO

    @Calcular inercia 2
    R2 2^ M2 *
    'I2' STO
    @Calcular inercia 1
    R1 2^ M1 *
    'I1' STO

    @Resultados
    F0x "F0_x" TAG
    F0y "F0_y" TAG
    F1x "F1_x" TAG
    F1y "F1_y" TAG
    F2x "F2_x" TAG
    F2y "F2_y" TAG
    FBx "FB_x" TAG    
    FBy "FB_y" TAG
    M2R2x "M2R2_x" TAG
    M2R2y "M2R2_y" TAG
    M1R1x "M1R1_x" TAG
    M1R1y "M1R1_y" TAG
    o2 "o_2" TAG
    o1 "o_1" TAG
    M2 "M2" TAG
    M1 "M1" TAG
    F2 "F2" TAG
    F1 "F1" TAG
    I2 "I2" TAG
    I1 "I1" TAG


    {I1 I2 F1x F1y F1 F2y F2x F2 M1 M2 o1 o2 M1R1y M1R1x M2R2y M2R2x FBy FBx F0y F0x lista 
    W lB l2 l1 R2 R1 oB FB o0 F0} PURGE

  
